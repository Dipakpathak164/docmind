# DocMind Environment Variables Template
# Copy this file to '.env' and fill in your API keys.

# Required API Keys
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI key used for generating embeddings (text-embedding-3-small)

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Anthropic key used for querying the LLM (claude-3-5-sonnet-20241022)

# Optional Vector DB Configuration
CHROMA_PERSIST_DIR=./chroma_db
# Path where the persistent local Chroma DB files are stored (default: ./chroma_db)

COLLECTION_NAME=docmind
# Name of the Chroma collection used for indexing documents (default: docmind)

# Chunking & Node Splitting Parameters
CHUNK_SIZE=512
# Max token size for splitting text chunks (default: 512)

CHUNK_OVERLAP=64
# Token overlap between adjacent chunks (default: 64)

# Retrieval Configuration
TOP_K=3
# Number of similar chunks to retrieve per query (default: 3)

SIMILARITY_CUTOFF=0.7
# Score cutoff under which retrieved nodes are ignored (default: 0.7)
